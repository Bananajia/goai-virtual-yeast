      "matched_control_raw_fc": 25,
      "context_mean_residual": 20,
      "drug_mean_residual": 20,
      "double_unknown_or_time": 10,
      "high_response_dep": 5
    },
    "synthesize_official_total": false,
    "compliance_gate": "separate",
    "open_source_contribution": {
      "weight_percent": 5,
      "separate_dimension": true
    }
  },
  "historical_sensitivity": {
    "residual_reference": "evaluation_centered",
    "dep_threshold_quantile": 0.9,
    "label": "not_official_primary"
  }
